# =====================================================================
# PantaSwarm AI Multi-Agent Configuration
# =====================================================================

# Default Provider to use: ollama | openrouter | gemini | vertex | openai | groq
AI_PROVIDER=ollama

# ---------------------------------------------------------------------
# Option 1: Local / Free Open-Weights Models with Ollama (Recommended)
# Run `ollama serve` and `ollama run qwen2.5-coder:7b` (or 1.5b/3b for fast CPU)
# ---------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------
# Option 2: 100% Free Cloud Models via OpenRouter
# (Get a free key from https://openrouter.ai/keys)
# ---------------------------------------------------------------------
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# (Other free alternatives: meta-llama/llama-3.3-70b-instruct:free, mistralai/mistral-7b-instruct:free)

# ---------------------------------------------------------------------
# Option 3: Google Gemini API (Free Tier on Google AI Studio)
# (Get a free key from https://aistudio.google.com/app/apikey)
# ---------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Option 4: Groq Ultra-Fast Free Cloud Inference
# (Get a free key from https://console.groq.com)
# ---------------------------------------------------------------------
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
